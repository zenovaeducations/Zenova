<div id="login" class="login"><div class="loginbox"><div class="brand"><i>Z</i> ZENOVA STUDIO</div><h2>Content Studio</h2><p>Manage WatchClass videos, academic chapters, thumbnails and schedules. Sign in using your authorized Zenova administrator Google account.</p><div id="loginError" class="msg error hidden"></div><button class="btn primary" id="loginBtn">Continue with Google</button></div></div>
<div id="app" class="shell hidden"><aside class="side"><div class="brand"><i>Z</i> ZENOVA STUDIO</div><nav class="nav"><button class="active" data-view="overview">▦ &nbsp; Overview</button><button data-view="videos">▣ &nbsp; Videos</button><button data-view="editor">＋ &nbsp; Add video</button><button data-view="structure">▤ &nbsp; Subjects & chapters</button><button data-view="schedule">◷ &nbsp; Schedules</button><button id="analytics">▥ &nbsp; Analytics Studio</button><button id="logout">⇥ &nbsp; Sign out</button></nav></aside><div class="main"><header class="top"><b>Zenova Educations · WatchClass Content Studio</b><span id="email" class="muted"></span></header><main class="content">
<section id="overview" class="view active"><div class="head"><div><div class="eyebrow">ACADEMIC CONTENT</div><h1>Content overview</h1><p>Manage every WatchClass lesson from one place.</p></div><button class="btn primary" id="quickAdd">＋ Add video</button></div><div class="stats"><div class="stat"><label>Total videos</label><strong id="total">—</strong></div><div class="stat"><label>Published</label><strong id="published">—</strong></div><div class="stat"><label>Upcoming</label><strong id="upcoming">—</strong></div><div class="stat"><label>Drafts</label><strong id="drafts">—</strong></div></div><div class="panel"><h3>Recently updated videos</h3><p>Latest content changes</p><div class="tablewrap"><table><thead><tr><th>Video</th><th>Subject / Chapter</th><th>Schedule</th><th>Status</th><th>Action</th></tr></thead><tbody id="recent"><tr><td colspan="5" class="empty">Loading…</td></tr></tbody></table></div></div></section>
<section id="videos" class="view"><div class="head"><div><div class="eyebrow">LIBRARY</div><h1>Videos</h1><p>Search, filter, edit and publish lessons.</p></div><button class="btn primary" id="addVideo">＋ Add video</button></div><div class="panel"><div class="toolbar"><input class="control search" id="search" placeholder="Search title, subject or chapter"><select class="control" id="statusFilter"><option value="all">All statuses</option><option value="published">Published</option><option value="draft">Drafts</option></select><select class="control" id="subjectFilter"><option value="all">All subjects</option></select></div><div class="tablewrap"><table><thead><tr><th>Video</th><th>Subject / Chapter</th><th>Schedule</th><th>Source</th><th>Status</th><th>Actions</th></tr></thead><tbody id="rows"><tr><td colspan="6" class="empty">Loading…</td></tr></tbody></table></div></div></section>
<section id="editor" class="view"><div class="head"><div><div class="eyebrow">CONTENT EDITOR</div><h1 id="editorTitle">Add a video</h1><p>Set lesson details, source, thumbnail, schedule and optional assessment.</p></div><button class="btn" id="back">← Videos</button></div><form id="form"><input type="hidden" id="videoId"><div class="panel"><h3>1. Video details</h3><p>Every video belongs to a subject and chapter.</p><div class="formgrid"><div class="field full"><label>Video title *</label><input class="control" id="title" required maxlength="160"></div><div class="field"><label>Subject *</label><select class="control" id="subject" required></select></div><div class="field"><label>Chapter *</label><select class="control" id="chapter" required></select></div><div class="field"><label>Lesson number *</label><input class="control" id="lesson" type="number" min="1" value="1" required></div><div class="field"><label>Duration (minutes)</label><input class="control" id="duration" type="number" min="1"></div><div class="field full"><label>Description</label><textarea class="control" id="description" rows="3"></textarea></div></div></div><div class="panel"><h3>2. Video source</h3><p>Choose YouTube, direct MP4/HLS URL or upload to Firebase Storage.</p><label class="choice"><input type="radio" name="provider" value="youtube" checked> YouTube</label><label class="choice"><input type="radio" name="provider" value="direct"> Direct URL / HLS</label><label class="choice"><input type="radio" name="provider" value="upload"> Upload MP4</label><div class="field" id="urlField" style="margin-top:14px"><label>Video URL *</label><input class="control" id="url" placeholder="YouTube / MP4 / M3U8 URL"></div><div class="field hidden" id="fileField" style="margin-top:14px"><label>Video file *</label><input class="control" type="file" id="file" accept="video/mp4,video/webm,video/quicktime"><div id="uploadState" class="help"></div></div></div><div class="panel"><h3>3. Thumbnail</h3><p>Upload via your secure ImgBB endpoint or paste an image URL.</p><div class="formgrid"><div class="field"><label>Choose thumbnail</label><input class="control" id="thumbFile" type="file" accept="image/*"></div><div class="field"><label>Thumbnail URL</label><input class="control" id="thumbUrl" placeholder="https://..."></div><div class="field full"><img id="thumbPreview" class="preview hidden" alt="Thumbnail preview"></div><div class="field full"><label>Secure ImgBB upload endpoint</label><input class="control" id="imgbbEndpoint" placeholder="https://your-domain.com/api/upload-thumbnail"><div class="help">The endpoint must keep the ImgBB API key server-side and return an image URL. Do not expose your API key in this page.</div></div></div></div><div class="panel"><h3>4. Schedule</h3><p>Choose fixed date/time or a recurring daily schedule.</p><label class="choice"><input type="radio" name="schedule" value="fixed" checked> Fixed date & time</label><label class="choice"><input type="radio" name="schedule" value="daily"> Daily recurring</label><div class="formgrid" style="margin-top:14px"><div class="field" id="dateWrap"><label>Scheduled date *</label><input class="control" id="date" type="date"></div><div class="field"><label>Start time *</label><input class="control" id="time" type="time" value="08:00" required></div><div class="field hidden" id="startWrap"><label>Recurring start date *</label><input class="control" id="startDate" type="date"></div><div class="field hidden" id="endWrap"><label>Recurring end date</label><input class="control" id="endDate" type="date"></div><div class="field full hidden" id="daysWrap"><label>Repeat on</label><div>${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map((x,i)=>`<label class="choice"><input type="checkbox" class="weekday" value="${i}" checked>${x}</label>`).join('')}</div></div></div><div class="help">Timezone: Asia/Kolkata. Recurring dates must be materialized as individual lesson occurrences for accurate student progress and analytics.</div></div><div class="panel"><h3>5. Assessment</h3><p>Adding a test is optional. When attached, student submission is compulsory.</p><label class="choice"><input type="checkbox" id="attachTest"> Attach an MCQ test</label><div id="testFields" class="formgrid hidden" style="margin-top:14px"><div class="field"><label>Test title</label><input class="control" id="testTitle"></div><div class="field"><label>Duration (minutes)</label><input class="control" id="testDuration" type="number" value="10" min="1"></div><div class="field"><label>Pass percentage</label><input class="control" id="pass" type="number" value="40" min="0" max="100"></div><div class="field"><label>Maximum attempts</label><input class="control" id="attempts" type="number" value="1" min="1"></div><div class="field full help">Question creation and answer-key management will be in the MCQ Tests module. A test should not be published until its questions are ready.</div></div></div><div id="formError" class="msg error hidden"></div><div class="foot"><button type="button" class="btn" id="saveDraft">Save draft</button><button class="btn primary" id="savePublish">Save & publish</button></div></form></section>
<section id="structure" class="view"><div class="head"><div><div class="eyebrow">ACADEMIC STRUCTURE</div><h1>Subjects & chapters</h1><p>Read-only view of existing Zenova academic records.</p></div></div><div class="panel"><h3>Subjects</h3><div id="subjectList" class="empty">Loading…</div></div><div class="panel"><h3>Chapters</h3><select class="control" id="chapterSubjectFilter"><option value="">All subjects</option></select><div id="chapterList" class="empty">Select a subject.</div></div></section>
<section id="schedule" class="view"><div class="head"><div><div class="eyebrow">PUBLISHING CALENDAR</div><h1>Schedules</h1><p>Lessons scheduled for a selected date.</p></div></div><div class="panel"><div class="toolbar"><input class="control" type="date" id="scheduleDate"><select class="control" id="scheduleSubject"><option value="all">All subjects</option></select></div><div id="scheduleList" class="empty">Choose a date.</div></div></section>
</main></div></div><div id="toast" class="toast hidden"></div>
<script type="module">
import{auth,db,storage}from'../../firebase/firebase-config.js';import{GoogleAuthProvider,signInWithPopup,onAuthStateChanged,signOut}from'https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js';import{collection,doc,getDoc,addDoc,updateDoc,deleteDoc,onSnapshot,serverTimestamp}from'https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js';import{ref,uploadBytesResumable,getDownloadURL}from'https://www.gstatic.com/firebasejs/12.1.0/firebase-storage.js';
const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let user=null,videos=[],subjects=[],chapters=[],offs=[];const today=()=>new Date().toLocaleDateString('en-CA');function toast(s){$('toast').textContent=s;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),3200)}function setView(v){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===v));document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x.dataset.view===v));if(v==='videos')renderVideos();if(v==='schedule')renderSchedule();if(v==='structure')renderStructure()}document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>setView(b.dataset.view));$('quickAdd').onclick=$('addVideo').onclick=()=>{reset();setView('editor')};$('back').onclick=()=>setView('videos');$('analytics').onclick=()=>location.href='../analyse/index.html';$('logout').onclick=()=>signOut(auth);
function opts(el,arr,placeholder){el.innerHTML=`<option value="">${esc(placeholder)}</option>`+arr.map(x=>`<option value="${esc(x.id)}">${esc(x.label)}</option>`).join('')}function sname(x){return x.name||x.title||x.subjectName||'Subject'}function cname(x){return x.title||x.name||x.chapterName||'Chapter'}function subjectOptions(){let a=subjects.map(x=>({id:x.id,label:sname(x)}));opts($('subject'),a,'Select subject');opts($('subjectFilter'),[{id:'all',label:'All subjects'},...a],'All subjects');opts($('scheduleSubject'),[{id:'all',label:'All subjects'},...a],'All subjects');opts($('chapterSubjectFilter'),[{id:'all',label:'All subjects'},...a],'All subjects')}function chapterOptions(){opts($('chapter'),chapters.filter(x=>x.subjectId===$('subject').value).map(x=>({id:x.id,label:cname(x)})),'Select chapter')}$('subject').onchange=chapterOptions;
function renderStructure(){$('subjectList').innerHTML=subjects.map(x=>`<p>${esc(sname(x))} <span class="muted">· ${chapters.filter(c=>c.subjectId===x.id).length} chapters</span></p>`).join('')||'No records found in zen2Subjects.';let sid=$('chapterSubjectFilter').value;$('chapterList').innerHTML=chapters.filter(x=>sid==='all'||!sid||x.subjectId===sid).map(x=>`<p>${esc(cname(x))}</p>`).join('')||'No chapters found.'}$('chapterSubjectFilter').onchange=renderStructure;
function modeUI(){let d=document.querySelector('[name=schedule]:checked').value==='daily';$('dateWrap').classList.toggle('hidden',d);$('startWrap').classList.toggle('hidden',!d);$('endWrap').classList.toggle('hidden',!d);$('daysWrap').classList.toggle('hidden',!d);$('date').required=!d;$('startDate').required=d}document.querySelectorAll('[name=schedule]').forEach(x=>x.onchange=modeUI);function sourceUI(){let p=document.querySelector('[name=provider]:checked').value;$('fileField').classList.toggle('hidden',p!=='upload');$('urlField').classList.toggle('hidden',p==='upload')}document.querySelectorAll('[name=provider]').forEach(x=>x.onchange=sourceUI);$('attachTest').onchange=()=>$('testFields').classList.toggle('hidden',!$('attachTest').checked);
$('thumbUrl').oninput=()=>{let u=$('thumbUrl').value;$('thumbPreview').src=u;$('thumbPreview').classList.toggle('hidden',!u)};$('thumbFile').onchange=async()=>{let f=$('thumbFile').files[0],endpoint=$('imgbbEndpoint').value.trim();if(!f)return;if(!endpoint){toast('Configure the secure ImgBB upload endpoint first.');return}try{let fd=new FormData();fd.append('image',f);let r=await fetch(endpoint,{method:'POST',body:fd});if(!r.ok)throw Error('Thumbnail upload failed: '+r.status);let j=await r.json(),url=j.url||j.data?.url;if(!url)throw Error('Upload endpoint did not return image URL.');$('thumbUrl').value=url;$('thumbPreview').src=url;$('thumbPreview').classList.remove('hidden');toast('Thumbnail uploaded.')}catch(e){toast(e.message)}};
function reset(){$('form').reset();$('videoId').value='';$('editorTitle').textContent='Add a video';$('date').value=today();$('startDate').value=today();$('time').value='08:00';$('lesson').value=1;$('formError').classList.add('hidden');$('thumbPreview').classList.add('hidden');$('testFields').classList.add('hidden');document.querySelector('[name=provider][value=youtube]').checked=true;document.querySelector('[name=schedule][value=fixed]').checked=true;subjectOptions();chapterOptions();sourceUI();modeUI()}async function upload(file){if(!file)throw Error('Choose an MP4/WebM video file.');if(file.size>500*1024*1024)throw Error('Video exceeds 500 MB.');let task=uploadBytesResumable(ref(storage,`watchClassVideos/${user.uid}/${Date.now()}_${file.name.replace(/[^\w.-]/g,'_')}`),file,{contentType:file.type});return await new Promise((resolve,reject)=>task.on('state_changed',s=>$('uploadState').textContent=`Uploading ${Math.round(s.bytesTransferred/s.totalBytes*100)}%`,reject,async()=>resolve(await getDownloadURL(task.snapshot.ref))))}function parseUrl(raw,provider){try{let u=new URL(raw);if(!['http:','https:'].includes(u.protocol))return null;if(provider==='youtube'){let h=u.hostname.replace(/^www\./,''),id=h==='youtu.be'?u.pathname.slice(1):u.searchParams.get('v')||u.pathname.split('/').filter(Boolean).pop();if(!id)return null;return{type:'youtube',embedUrl:`https://www.youtube-nocookie.com/embed/${id}?rel=0`,sourceUrl:u.href}}return{type:/\.m3u8(?:$|\?)/i.test(u.href)?'hls':'direct',sourceUrl:u.href}}catch{return null}}
async function save(publish){let p=document.querySelector('[name=provider]:checked').value,source=p==='upload'?{type:'direct',sourceUrl:await upload($('file').files[0])}:parseUrl($('url').value.trim(),p);if(!source)throw Error('Enter a valid YouTube or direct video URL.');let s=subjects.find(x=>x.id===$('subject').value),c=chapters.find(x=>x.id===$('chapter').value);if(!s||!c)throw Error('Select an existing subject and chapter.');let schedule=document.querySelector('[name=schedule]:checked').value,payload={title:$('title').value.trim(),description:$('description').value.trim(),subjectId:s.id,subjectName:sname(s),chapterId:c.id,chapterName:cname(c),lessonNumber:Number($('lesson').value)||1,sequence:Number($('lesson').value)||1,durationSeconds:(Number($('duration').value)||0)*60,videoProvider:p==='upload'?'direct':p,sourceType:source.type,sourceUrl:source.sourceUrl,embedUrl:source.embedUrl||'',thumbnailUrl:$('thumbUrl').value.trim(),scheduleMode:schedule,releaseTime:$('time').value,timezone:'Asia/Kolkata',published:publish,active:true,status:publish?'published':'draft',updatedAt:serverTimestamp(),updatedBy:user.uid};if(!payload.title)throw Error('Enter a video title.');if(schedule==='fixed'){let d=$('date').value;if(!d)throw Error('Select schedule date.');payload.releaseDate=d;payload.scheduledAt=new Date(`${d}T${$('time').value}:00+05:30`);payload.weekdays=[]}else{payload.startDate=$('startDate').value;payload.endDate=$('endDate').value||null;payload.weekdays=[...document.querySelectorAll('.weekday:checked')].map(x=>+x.value);if(!payload.startDate||!payload.weekdays.length)throw Error('Set recurring start date and weekdays.');payload.releaseDate=payload.startDate;payload.scheduledAt=null}let id=$('videoId').value;if(id)await updateDoc(doc(db,'watchClassVideos',id),payload);else{payload.createdAt=serverTimestamp();payload.createdBy=user.uid;let d=await addDoc(collection(db,'watchClassVideos'),payload);id=d.id}if($('attachTest').checked){if(!$('testTitle').value.trim())throw Error('Enter test title.');await addDoc(collection(db,'watchClassTests'),{videoId:id,subjectId:s.id,chapterId:c.id,title:$('testTitle').value.trim(),durationMinutes:+$('testDuration').value||10,passPercentage:+$('pass').value||40,maxAttempts:+$('attempts').value||1,mandatory:true,active:false,createdAt:serverTimestamp(),createdBy:user.uid})}toast(publish?'Video published.':'Draft saved.');reset();setView('videos')}$('form').onsubmit=async e=>{e.preventDefault();try{await save(true)}catch(err){$('formError').textContent=err.message;$('formError').classList.remove('hidden')}};$('saveDraft').onclick=async()=>{try{await save(false)}catch(err){$('formError').textContent=err.message;$('formError').classList.remove('hidden')} };
function status(v){return v.published||v.status==='published'?'Published':v.scheduleMode==='fixed'&&v.releaseDate>today()?'Scheduled':'Draft'}function row(v){return `<tr><td><div class="rowvideo"><img class="thumb" src="${esc(v.thumbnailUrl||'')}" onerror="this.style.visibility='hidden'"><div><b>${esc(v.title)}</b><div class="muted">Lesson ${v.lessonNumber||v.sequence||1}</div></div></div></td><td>${esc(v.subjectName||'—')}<div class="muted">${esc(v.chapterName||'')}</div></td><td>${esc(v.scheduleMode==='daily'?'Daily':v.releaseDate||'—')}<div class="muted">${esc(v.releaseTime||'')}</div></td><td>${esc((v.videoProvider||v.sourceType||'').toUpperCase())}</td><td><span class="pill ${status(v)==='Published'?'green':status(v)==='Scheduled'?'amber':''}">${status(v)}</span></td><td><div class="actions"><button class="btn small" data-edit="${esc(v.id)}">Edit</button><button class="btn small soft" data-publish="${esc(v.id)}">${v.published?'Unpublish':'Publish'}</button><button class="btn small danger" data-delete="${esc(v.id)}">Delete</button></div></td></tr>`}function renderVideos(){let q=$('search').value.toLowerCase(),st=$('statusFilter').value,sid=$('subjectFilter').value,list=videos.filter(v=>(!q||[v.title,v.subjectName,v.chapterName].join(' ').toLowerCase().includes(q))&&(st==='all'||(st==='published'&&v.published)||(st==='draft'&&!v.published))&&(sid==='all'||v.subjectId===sid));$('rows').innerHTML=list.length?list.map(row).join(''):'<tr><td colspan="6" class="empty">No videos found.</td></tr>'}function renderOverview(){$('total').textContent=videos.length;$('published').textContent=videos.filter(v=>v.published).length;$('upcoming').textContent=videos.filter(v=>v.scheduleMode==='fixed'&&v.releaseDate>today()).length;$('drafts').textContent=videos.filter(v=>!v.published).length;$('recent').innerHTML=[...videos].sort((a,b)=>(b.updatedAt?.seconds||0)-(a.updatedAt?.seconds||0)).slice(0,6).map(row).join('')||'<tr><td colspan="5" class="empty">No videos yet.</td></tr>'}function renderSchedule(){let date=$('scheduleDate').value,sid=$('scheduleSubject').value,list=videos.filter(v=>(sid==='all'||!sid||v.subjectId===sid)&&(v.scheduleMode==='daily'||v.releaseDate===date));$('scheduleList').innerHTML=list.length?`<div class="tablewrap"><table><tr><th>Time</th><th>Lesson</th><th>Subject / Chapter</th><th>Status</th></tr>${list.sort((a,b)=>(a.releaseTime||'').localeCompare(b.releaseTime||'')).map(v=>`<tr><td>${esc(v.releaseTime||'—')}</td><td>${esc(v.title)}</td><td>${esc(v.subjectName)} · ${esc(v.chapterName)}</td><td>${status(v)}</td></tr>`).join('')}</table></div>`:'No lessons scheduled.'}$('search').oninput=renderVideos;$('statusFilter').onchange=renderVideos;$('subjectFilter').onchange=renderVideos;$('scheduleDate').onchange=renderSchedule;$('scheduleSubject').onchange=renderSchedule;
$('rows').onclick=async e=>{let b=e.target.closest('button');if(!b)return;let v=videos.find(x=>x.id===b.dataset.edit||x.id===b.dataset.publish||x.id===b.dataset.delete);if(!v)return;if(b.dataset.edit){reset();$('videoId').value=v.id;$('editorTitle').textContent='Edit video';$('title').value=v.title||'';$('subject').value=v.subjectId||'';chapterOptions();$('chapter').value=v.chapterId||'';$('lesson').value=v.lessonNumber||v.sequence||1;$('duration').value=Math.round((v.durationSeconds||0)/60)||'';$('description').value=v.description||'';$('url').value=v.sourceUrl||'';$('thumbUrl').value=v.thumbnailUrl||'';$('thumbPreview').src=v.thumbnailUrl||'';$('thumbPreview').classList.toggle('hidden',!v.thumbnailUrl);setView('editor')}else if(b.dataset.publish){await updateDoc(doc(db,'watchClassVideos',v.id),{published:!v.published,status:v.published?'draft':'published',updatedAt:serverTimestamp(),updatedBy:user.uid})}else if(b.dataset.delete&&confirm(`Delete ${v.title}? Historical student records will be retained.`)){await deleteDoc(doc(db,'watchClassVideos',v.id));toast('Video deleted.')}};$('recent').onclick=e=>{let b=e.target.closest('[data-edit]');if(b){let v=videos.find(x=>x.id===b.dataset.edit);if(v){reset();$('videoId').value=v.id;$('title').value=v.title||'';$('subject').value=v.subjectId||'';chapterOptions();$('chapter').value=v.chapterId||'';$('url').value=v.sourceUrl||'';$('thumbUrl').value=v.thumbnailUrl||'';setView('editor')}}};
function listen(){offs.forEach(f=>f());offs=[];offs.push(onSnapshot(collection(db,'zen2Subjects'),s=>{subjects=s.docs.map(d=>({id:d.id,...d.data()}));subjectOptions();renderStructure()},e=>toast('Subjects: '+e.message)));offs.push(onSnapshot(collection(db,'zen2Chapters'),s=>{chapters=s.docs.map(d=>({id:d.id,...d.data()}));chapterOptions();renderStructure()},e=>toast('Chapters: '+e.message)));offs.push(onSnapshot(collection(db,'watchClassVideos'),s=>{videos=s.docs.map(d=>({id:d.id,...d.data()}));renderOverview();renderVideos();renderSchedule()},e=>toast('Video permission/data error: '+e.message)))}async function enter(u){user=u;try{let a=await getDoc(doc(db,'admins',u.uid));if(!a.exists()||a.data().active===false)throw Error('Active admins/'+u.uid+' record required.');let role=String(a.data().role||'').toLowerCase();if(role&&!['owner','superadmin','admin','administrator','contentadmin'].includes(role))throw Error('Your role cannot access Content Studio.');$('email').textContent=u.email||'Admin';$('login').classList.add('hidden');$('app').classList.remove('hidden');$('date').value=today();$('scheduleDate').value=today();listen()}catch(e){$('loginError').textContent='Access denied: '+e.message;$('loginError').classList.remove('hidden');await signOut(auth).catch(()=>{})}}$('loginBtn').onclick=async()=>{try{await signInWithPopup(auth,new GoogleAuthProvider())}catch(e){$('loginError').textContent=e.message;$('loginError').classList.remove('hidden')}};onAuthStateChanged(auth,u=>{if(u)enter(u);else{offs.forEach(f=>f());$('app').classList.add('hidden');$('login').classList.remove('hidden')}});reset();
